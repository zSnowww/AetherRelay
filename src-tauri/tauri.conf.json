{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Relay",
  "version": "0.1.7",
  "identifier": "dev.zsnow.aetherrelay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/sign-macos-tools.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [{
      "title": "Aether Relay",
      "width": 1080,
      "height": 760,
      "minWidth": 780,
      "minHeight": 650,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "backgroundColor": "#090c09"
    }],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "zsnow",
    "copyright": "Copyright 2026 zsnow",
    "homepage": "https://zsnow.dev",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "tools/": "tools/",
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRDlDRTMzNEE5RTY0NUIKUldSYlpKNUtNODdab2RtVlliSFdYL1lLdlZjSkdxaTFwckFEdjhUTFY1V0JST1B3eWxiRFBxWG8K",
      "endpoints": [
        "https://github.com/zSnowww/AetherRelay/releases/latest/download/latest.json"
      ]
    }
  }
}
